# Runtime
APP_ENV=development
DRY_RUN=true
LIVE_TRADING=false
LOG_LEVEL=INFO
TIMEZONE=UTC

# Polymarket CLOB V2 -- populate only in the isolated trading service
CLOB_HOST=https://clob.polymarket.com
CHAIN_ID=137
SIGNATURE_TYPE=3
PRIVATE_KEY=REPLACE_LOCALLY
DEPOSIT_WALLET_ADDRESS=REPLACE_LOCALLY
CLOB_API_KEY=REPLACE_LOCALLY
CLOB_API_SECRET=REPLACE_LOCALLY
CLOB_API_PASSPHRASE=REPLACE_LOCALLY

# Market scope
ASSETS=BTC
TIMEFRAMES=5m
ALLOW_ETH=false
ALLOW_15M=false
ALLOW_1H=false
ALLOW_4H=false

# Data validation
MAX_SETTLEMENT_FEED_AGE_MS=2000
MAX_BINANCE_FEED_AGE_MS=1500
MAX_BINANCE_CHAINLINK_BASIS_BPS=15
MAX_LOCAL_CLOCK_OFFSET_MS=250
REQUIRE_REFERENCE_PRICE_VERIFICATION=true

# Strategy
MODEL_VERSION=btc5m-v1
NET_EDGE_MIN=0.035
MODEL_UNCERTAINTY_FLOOR=0.015
MAX_ENTRY_PRICE=0.90
MIN_ENTRY_PRICE=0.10
MAX_SPREAD=0.025
MIN_DEPTH_MULTIPLE=5
MIN_TIME_REMAINING_SEC=20
MAX_TIME_REMAINING_SEC=240

# Execution
PREFER_POST_ONLY=true
ALLOW_TAKER=true
MAX_EXPECTED_SLIPPAGE=0.01
ORDER_TTL_MS=1500
MAX_TRANCHES=3
TRANCHE_WEIGHTS=0.25,0.35,0.40
CANCEL_ON_FEED_STALE=true
CANCEL_ON_SIGNAL_REVERSAL=true

# Risk for initial $100 validation bankroll
BANKROLL_USD=100
FIXED_ORDER_USD=1.00
MAX_ORDER_USD=1.00
MAX_MARKET_EXPOSURE_USD=1.50
MAX_ASSET_EXPOSURE_USD=2.00
MAX_OPEN_MARKETS=2
DAILY_LOSS_LIMIT_USD=3.00
DAILY_DRAWDOWN_LIMIT_PCT=0.03
WEEKLY_DRAWDOWN_LIMIT_PCT=0.07
KELLY_ENABLED=false
LONGSHOT_ENABLED=false

# Safety and journaling
RECONCILE_INTERVAL_SEC=5
HEARTBEAT_INTERVAL_SEC=5
KILL_ON_RECONCILIATION_ERROR=true
KILL_ON_EXCESS_REJECTIONS=true
MAX_REJECTIONS_PER_HOUR=5
SANITIZED_JOURNAL_DIR=/absolute/path/to/shared/sanitized-journal
PRIVATE_LOG_DIR=/absolute/path/to/private/trading-logs
CONFIG_VERSION=btc5m-dry-v1

