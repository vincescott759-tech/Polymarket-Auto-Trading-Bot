# This environment must never contain wallet or CLOB credentials.
SANITIZED_JOURNAL_DIR=/absolute/path/to/shared/sanitized-journal
PROPOSAL_DIR=/absolute/path/to/shared/proposals
APPROVED_CONFIG_DIR=/absolute/path/to/shared/approved-configs

TELEGRAM_BOT_TOKEN=REPLACE_LOCALLY
TELEGRAM_ALLOWED_CHAT_ID=REPLACE_LOCALLY
TELEGRAM_HOME_CHANNEL=REPLACE_LOCALLY

REVIEW_TIMEZONE=Asia/Taipei
MIN_SAMPLE_FOR_PARAMETER_PROPOSAL=2000
MIN_WALK_FORWARD_FOLDS=5
PROPOSAL_EXPIRY_HOURS=24
ALLOW_AUTOMATIC_CONFIG_APPLY=false
ALLOW_AUTOMATIC_CODE_CHANGE=false
ALLOW_RISK_LIMIT_INCREASE=false
